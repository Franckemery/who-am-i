{
  "expo": {
    "name": "WHO AM I",
    "slug": "who-am-i",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "who-am-i",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#080B12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whoami.thoughts"
    },
    "android": {
      "package": "com.whoami.thoughts",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080B12"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "8e572d5c-f330-43be-8fca-beb9d8d243c5"
      }
    }
  }
}
